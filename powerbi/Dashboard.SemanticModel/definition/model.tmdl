model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_fornecedor","dim_localidade","dim_modalidade","dim_orgao","fato_item_contratado","_medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_fornecedor
ref table dim_localidade
ref table dim_modalidade
ref table dim_orgao
ref table fato_item_contratado
ref table _medidas
ref table d_calendario

ref cultureInfo pt-BR

